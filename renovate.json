{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 50,
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",
  "ignorePaths": [
    "apps/**",
    "core/**",
    "clusters/**",
    ".ref/**"
  ],
  "flux": {
    "managerFilePatterns": [
      "/^nerv/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^nerv/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Annotated deps: `# renovate: datasource=<ds> depName=<name>` on the line above the value",
      "managerFilePatterns": [
        "/^nerv/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+?: \"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Kubernetes API versions are not dependencies",
      "matchDatasources": [
        "kubernetes-api"
      ],
      "enabled": false
    },
    {
      "description": "gotk-components.yaml is regenerated as a whole by the flux manager (fluxcd/flux2); don't also bump its controller images one by one",
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "nerv/main/flux/flux-system/gotk-components.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Internal registry, not reachable from GitHub runners",
      "matchPackageNames": [
        "oci.nerv.id/**"
      ],
      "enabled": false
    },
    {
      "description": "Flux components move together",
      "matchPackageNames": [
        "/fluxcd/"
      ],
      "groupName": "flux"
    },
    {
      "description": "Intel device plugin charts move together",
      "matchPackageNames": [
        "/^intel-device-plugins-/"
      ],
      "groupName": "intel-device-plugins"
    },
    {
      "description": "Only tested one minor at a time - open a PR per minor instead of jumping to latest",
      "matchPackageNames": [
        "cilium",
        "longhorn",
        "/fluxcd/"
      ],
      "separateMultipleMinor": true
    },
    {
      "description": "Major updates need a human",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "renovate/major"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "description": "GitHub Actions minor/patch bumps don't touch the cluster - auto-merge them"
    }
  ]
}
